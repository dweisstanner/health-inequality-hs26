@article{lianAssociationSocioeconomicStatus2026,
  title = {Association between {{Socioeconomic Status}}, {{Lifestyle Factors}} and {{Mortality}}: {{A Scoping Review}}},
  shorttitle = {Association between {{Socioeconomic Status}}, {{Lifestyle Factors}} and {{Mortality}}},
  author = {Lian, Zhiwei and Zhu, Chunsu and Arndt, Volker and Thong, Melissa S. Y.},
  year = 2026,

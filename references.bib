}

@article{eikemoFirstPanEuropeanSociological2017,
  title = {The {{First Pan-European Sociological Health Inequalities Survey}} of the {{General Population}}: {{The European Social Survey Rotating Module}} on the {{Social Determinants}} of {{Health}}},

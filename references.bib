@article{rileySTATECIGARETTETAXES2024,
  title = {{{STATE CIGARETTE TAXES}}, {{SMOKING CESSATION}}, {{AND IMPLICATIONS FOR THE EDUCATIONAL GRADIENT IN MORTALITY}}},
  author = {Riley, Alicia R.},
